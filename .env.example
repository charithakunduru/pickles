# =================================================================
# Pickles Business API - Environment Configuration Example
# Copy this file to '.env' and adjust values for your environment.
# =================================================================

# -----------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------
APP_NAME="Pickles Business API"

# -----------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------
# For MySQL (Default):
DATABASE_URL=mysql+pymysql://root:nohithareddy@localhost:3306/pickles_db

# For SQLite (Alternative / Testing):
# DATABASE_URL=sqlite:///./pickles.db

# -----------------------------------------------------------------
# Security & JWT Authentication
# -----------------------------------------------------------------
# Secret key used for signing JWT tokens. ALWAYS change this in production!
SECRET_KEY=super-secret-key-change-this-in-production

# JWT algorithm (Default: HS256)
ALGORITHM=HS256

# JWT Access Token expiration time in minutes (Default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30
